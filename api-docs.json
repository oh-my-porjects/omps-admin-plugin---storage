{
  "module": "storage",
  "module_title": "文件存储",
  "apis": [
    {
      "method": "GET",
      "path": "/api/storage/hello",
      "endpoint_key": "GET /api/storage/hello",
      "title": "模块探活",
      "description": "返回 storage 模块名称和当前版本。",
      "auth": "public",
      "params": [],
      "response": {
        "description": "模块基础信息。",
        "data_type": "object",
        "fields": [
          {
            "name": "module",
            "type": "string",
            "description": "模块名称。"
          },
          {
            "name": "version",
            "type": "string",
            "description": "模块版本。"
          }
        ],
        "error_codes": []
      },
      "response_example": {
        "status": 0,
        "data": {
          "module": "storage",
          "version": "dev"
        },
        "msg": "ok"
      }
    },
    {
      "method": "POST",
      "path": "/api/storage/upload",
      "endpoint_key": "POST /api/storage/upload",
      "title": "上传图片资源",
      "description": "登录用户上传图片资源到对象存储，并保存资源元数据。仅允许 JPG、JPEG、PNG、WEBP。",
      "auth": "login",
      "params": [
        {
          "name": "X-User-ID",
          "type": "string",
          "required": true,
          "in": "header",
          "constraint": "12 位 base62 ID",
          "description": "当前登录用户 ID，由 runtime 登录态注入。"
        },
        {
          "name": "file",
          "type": "file",
          "required": true,
          "in": "formData",
          "constraint": "非空图片文件，格式为 JPG、JPEG、PNG 或 WEBP",
          "description": "要上传的图片文件。"
        },
        {
          "name": "feature",
          "type": "string",
          "required": true,
          "in": "formData",
          "constraint": "当前仅允许 recharge_voucher",
          "description": "资源用途。recharge_voucher 表示充值凭证截图。"
        },
        {
          "name": "business_object_type",
          "type": "string",
          "required": false,
          "in": "formData",
          "constraint": "为空或 recharge_order/user_profile",
          "description": "资源绑定的业务对象类型。"
        },
        {
          "name": "business_object_id",
          "type": "string",
          "required": false,
          "in": "formData",
          "constraint": "与 business_object_type 同时为空或同时填写，最多 100 字符",
          "description": "资源绑定的业务对象 ID。"
        }
      ],
      "request_example": {
        "feature": "recharge_voucher",
        "business_object_type": "recharge_order",
        "business_object_id": "Order0000001",
        "file": "voucher.png"
      },
      "response": {
        "description": "返回上传后的资源核心信息。",
        "data_type": "object",
        "fields": [
          {
            "name": "resource_id",
            "type": "string",
            "description": "资源 ID，12 位 base62。"
          },
          {
            "name": "public_url",
            "type": "string",
            "description": "资源公网访问地址。"
          },
          {
            "name": "storage_key",
            "type": "string",
            "description": "对象存储 key。"
          },
          {
            "name": "feature",
            "type": "string",
            "description": "资源用途。"
          },
          {
            "name": "status",
            "type": "string",
            "description": "资源状态：normal 正常、deleted 已软删除、cleaned 已清理。"
          },
          {
            "name": "mime_type",
            "type": "string",
            "description": "图片 MIME 类型。"
          },
          {
            "name": "file_size_bytes",
            "type": "integer",
            "description": "文件大小，单位字节。"
          },
          {
            "name": "uploaded_at",
            "type": "string",
            "description": "上传时间，RFC3339 字符串。"
          }
        ],
        "error_codes": [
          {
            "status": 8001,
            "msg": "未登录或登录态无效。"
          },
          {
            "status": 8002,
            "msg": "缺少上传文件或读取文件失败。"
          },
          {
            "status": 8003,
            "msg": "资源功能类型缺失或格式非法。"
          },
          {
            "status": 8004,
            "msg": "不支持的图片格式，仅允许 JPG、JPEG、PNG、WEBP。"
          },
          {
            "status": 8005,
            "msg": "业务对象类型或业务对象 ID 格式非法。"
          },
          {
            "status": 8006,
            "msg": "R2 存储配置缺失或不可用。"
          },
          {
            "status": 8007,
            "msg": "上传 R2 失败。"
          },
          {
            "status": 8008,
            "msg": "资源元数据保存失败。"
          }
        ]
      },
      "response_example": {
        "status": 0,
        "data": {
          "resource_id": "Res000000001",
          "public_url": "https://cdn.example.com/dev/recharge_voucher/u1/Res000000001.png",
          "storage_key": "dev/recharge_voucher/u1/Res000000001.png",
          "feature": "recharge_voucher",
          "status": "normal",
          "mime_type": "image/png",
          "file_size_bytes": 12345,
          "uploaded_at": "2026-05-28T00:00:00Z"
        },
        "msg": ""
      }
    },
    {
      "method": "GET",
      "path": "/api/storage/resource-list",
      "endpoint_key": "GET /api/storage/resource-list",
      "title": "查询资源列表",
      "description": "分页查询图片资源，可按用户、用途、业务对象、状态和上传时间范围过滤。",
      "auth": "admin_session",
      "params": [
        {
          "name": "user_id",
          "type": "string",
          "required": false,
          "constraint": "12 位 base62 ID",
          "description": "按上传用户过滤。"
        },
        {
          "name": "feature",
          "type": "string",
          "required": false,
          "constraint": "1-50 位 token",
          "description": "按资源用途过滤。"
        },
        {
          "name": "business_object_type",
          "type": "string",
          "required": false,
          "constraint": "1-50 位 token",
          "description": "按业务对象类型过滤。"
        },
        {
          "name": "business_object_id",
          "type": "string",
          "required": false,
          "constraint": "最多 100 字符 token",
          "description": "按业务对象 ID 过滤。"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "constraint": "空、normal、deleted 或 cleaned",
          "description": "按资源状态过滤。normal 正常，deleted 已软删除，cleaned 已清理。"
        },
        {
          "name": "uploaded_from",
          "type": "string",
          "required": false,
          "constraint": "RFC3339 时间字符串",
          "description": "上传开始时间。"
        },
        {
          "name": "uploaded_to",
          "type": "string",
          "required": false,
          "constraint": "RFC3339 时间字符串",
          "description": "上传结束时间。"
        },
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "constraint": "默认 1，大于等于 1",
          "description": "页码。"
        },
        {
          "name": "page_size",
          "type": "integer",
          "required": false,
          "constraint": "默认 20，1-100",
          "description": "每页数量。"
        }
      ],
      "response": {
        "description": "返回资源分页列表。",
        "data_type": "object",
        "fields": [
          {
            "name": "items",
            "type": "array",
            "description": "资源列表。",
            "fields": [
              {
                "name": "resource_id",
                "type": "string",
                "description": "资源 ID。"
              },
              {
                "name": "user_id",
                "type": "string",
                "description": "上传用户 ID。"
              },
              {
                "name": "feature",
                "type": "string",
                "description": "资源用途。"
              },
              {
                "name": "business_object_type",
                "type": "string",
                "description": "业务对象类型。"
              },
              {
                "name": "business_object_id",
                "type": "string",
                "description": "业务对象 ID。"
              },
              {
                "name": "public_url",
                "type": "string",
                "description": "公网访问地址。"
              },
              {
                "name": "status",
                "type": "string",
                "description": "资源状态：normal 正常、deleted 已软删除、cleaned 已清理。"
              },
              {
                "name": "mime_type",
                "type": "string",
                "description": "图片 MIME 类型。"
              },
              {
                "name": "file_size_bytes",
                "type": "integer",
                "description": "文件大小，单位字节。"
              },
              {
                "name": "uploaded_at",
                "type": "string",
                "description": "上传时间，RFC3339 字符串。"
              }
            ]
          },
          {
            "name": "total",
            "type": "integer",
            "description": "总数量。"
          },
          {
            "name": "page",
            "type": "integer",
            "description": "当前页码。"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页数量。"
          }
        ],
        "error_codes": [
          {
            "status": 8012,
            "msg": "筛选参数格式非法。"
          },
          {
            "status": 8013,
            "msg": "分页参数超出允许范围。"
          },
          {
            "status": 8014,
            "msg": "上传时间范围非法。"
          },
          {
            "status": 8015,
            "msg": "查询资源列表失败。"
          }
        ]
      },
      "response_example": {
        "status": 0,
        "data": {
          "items": [],
          "total": 0,
          "page": 1,
          "page_size": 20
        },
        "msg": ""
      }
    },
    {
      "method": "GET",
      "path": "/api/storage/resource-detail",
      "endpoint_key": "GET /api/storage/resource-detail",
      "title": "查询资源详情",
      "description": "按资源 ID 查询图片资源详情。",
      "auth": "admin_session",
      "params": [
        {
          "name": "resource_id",
          "type": "string",
          "required": true,
          "constraint": "12 位 base62 ID",
          "description": "资源 ID。"
        }
      ],
      "response": {
        "description": "返回资源详情。",
        "data_type": "object",
        "fields": [
          {
            "name": "resource_id",
            "type": "string",
            "description": "资源 ID。"
          },
          {
            "name": "user_id",
            "type": "string",
            "description": "上传用户 ID。"
          },
          {
            "name": "feature",
            "type": "string",
            "description": "资源用途。"
          },
          {
            "name": "business_object_type",
            "type": "string",
            "description": "业务对象类型。"
          },
          {
            "name": "business_object_id",
            "type": "string",
            "description": "业务对象 ID。"
          },
          {
            "name": "public_url",
            "type": "string",
            "description": "公网访问地址。"
          },
          {
            "name": "status",
            "type": "string",
            "description": "资源状态：normal 正常、deleted 已软删除、cleaned 已清理。"
          },
          {
            "name": "mime_type",
            "type": "string",
            "description": "图片 MIME 类型。"
          },
          {
            "name": "file_size_bytes",
            "type": "integer",
            "description": "文件大小，单位字节。"
          },
          {
            "name": "uploaded_at",
            "type": "string",
            "description": "上传时间，RFC3339 字符串。"
          },
          {
            "name": "original_filename",
            "type": "string",
            "description": "原始文件名。"
          },
          {
            "name": "storage_key",
            "type": "string",
            "description": "对象存储 key。"
          },
          {
            "name": "file_ext",
            "type": "string",
            "description": "文件扩展名。"
          },
          {
            "name": "created_at",
            "type": "string",
            "description": "创建时间，RFC3339 字符串。"
          },
          {
            "name": "updated_at",
            "type": "string",
            "description": "更新时间，RFC3339 字符串。"
          },
          {
            "name": "deleted_at",
            "type": "string",
            "description": "软删除时间，未删除时为空。"
          },
          {
            "name": "cleaned_at",
            "type": "string",
            "description": "清理时间，未清理时为空。"
          }
        ],
        "error_codes": [
          {
            "status": 8022,
            "msg": "资源 ID 缺失或格式非法。"
          },
          {
            "status": 8023,
            "msg": "资源不存在。"
          },
          {
            "status": 8024,
            "msg": "查询资源详情失败。"
          }
        ]
      },
      "response_example": {
        "status": 0,
        "data": {
          "resource_id": "Res000000001",
          "user_id": "User00000001",
          "feature": "recharge_voucher",
          "business_object_type": "recharge_order",
          "business_object_id": "Order0000001",
          "public_url": "https://cdn.example.com/dev/recharge_voucher/u1/Res000000001.png",
          "status": "normal",
          "mime_type": "image/png",
          "file_size_bytes": 12345,
          "uploaded_at": "2026-05-28T00:00:00Z",
          "original_filename": "voucher.png",
          "storage_key": "dev/recharge_voucher/u1/Res000000001.png",
          "file_ext": "png",
          "created_at": "2026-05-28T00:00:00Z",
          "updated_at": "2026-05-28T00:00:00Z",
          "deleted_at": "",
          "cleaned_at": ""
        },
        "msg": ""
      }
    },
    {
      "method": "POST",
      "path": "/api/storage/admin/ping",
      "endpoint_key": "POST /api/storage/admin/ping",
      "title": "后台连通性检查",
      "description": "管理端连通性检查接口，返回 pong。",
      "auth": "api_key",
      "params": [],
      "response": {
        "description": "固定返回 pong。",
        "data_type": "object",
        "fields": [],
        "error_codes": []
      },
      "response_example": {
        "status": 0,
        "data": null,
        "msg": "pong"
      }
    }
  ]
}
