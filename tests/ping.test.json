{
  "api": "POST /api/storage/admin/ping",
  "cases": [
    {
      "name": "后台 ping 正常返回 pong",
      "kind": "http",
      "actor": "admin",
      "expect_status": 200,
      "expect_field": {
        "status": 0,
        "msg": "pong"
      }
    },
    {
      "name": "未授权访问失败",
      "kind": "http",
      "actor": "anonymous",
      "method": "POST",
      "path": "/api/storage/admin/ping",
      "expect_status": 401
    }
  ]
}
