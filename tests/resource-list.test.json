{
  "api": "GET /api/storage/admin/resource-list",
  "cases": [
    {
      "name": "查询当前资源列表",
      "kind": "http",
      "actor": "admin",
      "query": {"page": 1, "page_size": 20, "include_history": false},
      "expect_status": 200,
      "expect_field": {"status": 0, "data.page": 1, "data.page_size": 20}
    },
    {
      "name": "分页参数非法返回 8013",
      "kind": "http",
      "actor": "admin",
      "query": {"page_size": 101},
      "expect_status": 200,
      "expect_field": {"status": 8013}
    },
    {
      "name": "上传时间范围非法返回 8014",
      "kind": "http",
      "actor": "admin",
      "query": {"uploaded_from_ts": 2000, "uploaded_to_ts": 1000},
      "expect_status": 200,
      "expect_field": {"status": 8014}
    }
  ]
}
