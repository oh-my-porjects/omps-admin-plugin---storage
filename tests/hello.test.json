{
  "api": "GET /api/storage/hello",
  "cases": [
    {
      "name": "hello 正常返回 status=0 + module/version 字段",
      "kind": "http",
      "actor": "anonymous",
      "expect_status": 200,
      "expect_field": {
        "status": 0,
        "data.module": "storage"
      }
    },
    {
      "name": "错误方法返回失败",
      "kind": "http",
      "actor": "anonymous",
      "method": "POST",
      "path": "/api/storage/hello",
      "expect_status": 405
    }
  ]
}
